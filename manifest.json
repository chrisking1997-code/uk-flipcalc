{
  "manifest_version": 3,
  "name": "UK FlipCalc — Global eBay & Vinted",
  "version": "2.1.1",
  "description": "Floating profit, ROI & break-even arbitrage calculator with automatic multi-country eBay Sold Comps valuation, live FX conversion, and instant buy/skip verdicts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.ebay.co.uk/*",
    "https://www.ebay.com/*",
    "https://www.ebay.de/*",
    "https://www.ebay.com.au/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.ca/*",
    "https://www.ebay.it/*",
    "https://open.er-api.com/*",
    "https://api.frankfurter.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.com/itm/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.com.au/itm/*",
        "https://www.ebay.fr/itm/*",
        "https://www.ebay.ca/itm/*",
        "https://www.ebay.it/itm/*",
        "https://www.ebay.co.uk/sch/*",
        "https://www.ebay.com/sch/*",
        "https://www.ebay.de/sch/*",
        "https://www.ebay.com.au/sch/*",
        "https://www.ebay.fr/sch/*",
        "https://www.ebay.ca/sch/*",
        "https://www.ebay.it/sch/*",
        "https://www.vinted.co.uk/items/*"
      ],
      "js": [
        "calculator.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "icons/icon.svg"
      ],
      "matches": [
        "https://www.ebay.co.uk/*",
        "https://www.ebay.com/*",
        "https://www.ebay.de/*",
        "https://www.ebay.com.au/*",
        "https://www.ebay.fr/*",
        "https://www.ebay.ca/*",
        "https://www.ebay.it/*",
        "https://www.vinted.co.uk/*"
      ]
    }
  ]
}
