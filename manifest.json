{
  "manifest_version": 3,
  "name": "UK FlipCalc",
  "version": "1.0.0",
  "description": "Floating UK profit, ROI & break-even arbitrage calculator for eBay UK and Vinted UK listings with 1-click eBay Sold Comps lookup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.co.uk/itm/*",
        "https://www.vinted.co.uk/items/*"
      ],
      "js": [
        "calculator.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "icons/icon.svg"
      ],
      "matches": [
        "https://www.ebay.co.uk/*",
        "https://www.vinted.co.uk/*"
      ]
    }
  ]
}
